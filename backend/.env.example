NODE_ENV=production
PORT=10000
FRONTEND_ORIGINS=https://institutodoacao.online,https://www.institutodoacao.online,https://SEU-PROJETO.vercel.app
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=COLOQUE_APENAS_NO_RENDER

VEOPAG_API_URL=https://api.veopag.com
VEOPAG_CLIENT_ID=COLOQUE_APENAS_NO_RENDER
VEOPAG_CLIENT_SECRET=COLOQUE_APENAS_NO_RENDER
VEOPAG_TOKEN_CACHE_MINUTES=55
VEOPAG_TIMEOUT_MS=12000
VEOPAG_WEBHOOK_URL=https://SEU-BACKEND.onrender.com/webhooks/veopag
VEOPAG_WEBHOOK_SIGNATURE=SEGREDO_CONFIGURADO_NO_PORTAL_VEOPAG
VEOPAG_CALLBACK_TOKEN=TOKEN_FIXO_ENVIADO_PELA_VEOPAG
VEOPAG_RECONCILE_INTERVAL_MS=300000

# Como a landing não pede CPF/e-mail, use somente dados autorizados pela sua conta VeoPag.
VEOPAG_DEFAULT_PAYER_NAME=Pagamento Digital
VEOPAG_DEFAULT_PAYER_EMAIL=noreply@pagamento.digital
VEOPAG_DEFAULT_PAYER_DOCUMENT=CPF_OU_CNPJ_AUTORIZADO
VEOPAG_DEFAULT_PAYER_PHONE=

CAMPAIGN_GOAL=130000
CAMPAIGN_INITIAL_AMOUNT=27847
PIX_RATE_LIMIT=5
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=COLOQUE_A_CHAVE_SECRETA_DO_TURNSTILE
USE_TEST_PAYERS=false

# Meta Conversions API — somente no Render/backend
META_PIXEL_ID=2279794442426700
META_CAPI_ACCESS_TOKEN=COLOQUE_O_TOKEN_GERADO_NO_GERENCIADOR_DE_EVENTOS
# Informe explicitamente uma versão ativa da Graph API, por exemplo v24.0.
META_API_VERSION=v24.0
META_EVENT_SOURCE_URL=https://institutodoacao.online
META_CAPI_TIMEOUT_MS=12000
# Use apenas durante o teste no Gerenciador de Eventos. Remova depois.
META_TEST_EVENT_CODE=
